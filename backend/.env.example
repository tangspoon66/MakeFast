# 运行环境
ENV=production
HOST=0.0.0.0
PORT=8000

# 生产域名/CORS
ALLOWED_ORIGINS=https://makerhub.xcats.cn
COOKIE_SECURE=true
# ENABLE_API_DOCS=true  # 是否启用 /api/docs，公网生产环境建议不设置或 false

# AI 代码助手配置
# DeepSeek 官方: https://platform.deepseek.com
# 硅基流动: https://siliconflow.cn
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# 固件/模板存储路径
FIRMWARE_STORAGE_PATH=./firmware_storage
TEMPLATE_STORAGE_PATH=./template_storage
APP_DATA_PATH=./data
OPS_DB_PATH=./data/ops.sqlite3

# 管理员账号
ADMIN_USERNAME=admin
# 生成密码哈希: pip install passlib bcrypt && python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('你的密码'))"
ADMIN_PASSWORD_HASH=

# JWT 配置
# 生成随机密钥: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=2

# Redis（生产建议启用，用于限流和任务状态）
REDIS_URL=redis://redis:6379/0

# 低配单机编译策略：小型服务器建议保持 1，避免 Arduino 编译把内存打满
COMPILE_CONCURRENCY=1
COMPILE_QUEUE_TIMEOUT_SECONDS=2

# S3-compatible 对象存储（Cloudflare R2 / 阿里 OSS / 腾讯 COS 均可按 S3 兼容方式配置）
# 小型单机可以先 false，后续课程资源变多再打开。
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=makerhub-assets
OBJECT_STORAGE_ENDPOINT=https://example.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=https://assets.example.com
OBJECT_STORAGE_PREFIX=makerhub
