  "constraints": [
    {
      "pin": "D2",
      "kind": "strapping",
      "severity": "warning",
      "childMessage": "D2（GPIO3）是芯片启动时会看的“开机脚”，接传感器有时会让小板启动不正常，换到 D0 或 D1 更稳。"
    },
    {
      "pin": "D6",
      "kind": "uart",
      "severity": "warning",
      "childMessage": "D6 是串口发送脚（TX），接别的元件可能和串口打架，建议换一个脚。"
    },
    {
      "pin": "D7",
      "kind": "uart",
      "severity": "warning",
      "childMessage": "D7 是串口接收脚（RX），接别的元件可能和串口打架，建议换一个脚。"
    }
  ],
