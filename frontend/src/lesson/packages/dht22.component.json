    "tempAccuracyC": 0.5,
    "humidityRangePct": [
      0,
      100
    ],
    "humidityAccuracyPct": 2,
    "minSampleIntervalMs": 2000,
    "onboardPullup": true
  },
  "library": {
    "name": "DHT sensor library",
    "vendor": "Adafruit",
    "include": "DHT.h",
    "arduinoLibraryManager": "DHT sensor library"
  },
  "blocks": [
    "mf_dht_setup",
    "mf_dht_read_temp",
    "mf_dht_read_humi"
  ],
