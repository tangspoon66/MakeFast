{
  "schemaVersion": "1.0",
  "id": "dht22",
  "name": "DHT22 温湿度模块（AM2302）",
  "category": "sensor",
  "logicVoltage": [
    3.3,
    5
  ],
  "capabilities": [
    "temperature",
    "humidity"
  ],
  "images": {
    "illustration": "module.svg"
  },
  "pinmap": "pinmap.json",
